{
  "name": "khidma-api",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.scripts.json",
    "db:generate": "node --env-file=.env ./node_modules/.bin/drizzle-kit generate",
    "db:migrate": "node --env-file=.env ./node_modules/.bin/drizzle-kit migrate",
    "seed": "tsx --env-file=.env scripts/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "drizzle-orm": "^1.0.0-rc.6",
    "express": "^5.3.0",
    "i18next": "^27.2.7",
    "i18next-fs-backend": "^2.7.3",
    "i18next-http-middleware": "^3.11.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.7",
    "@types/pg": "^8.23.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "^1.0.0-rc.6",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
